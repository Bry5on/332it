	"funData": [
    {
      "name": "retard",
      "values": [0, 0, 0, 0, 0, 0],
      "expr": [
        "(({knock status 1} & 7) == 1) ? x0 = {knock retard 1} : 0",
        "(({knock status 1} & 7) == 2) ? x1 = {knock retard 1} : 0",
        "(({knock status 1} & 7) == 3) ? x2 = {knock retard 1} : 0",
        "(({knock status 2} & 7) == 4) ? x3 = {knock retard 2} : 0",
        "(({knock status 2} & 7) == 5) ? x4 = {knock retard 2} : 0",
        "(({knock status 2} & 7) == 6) ? x5 = {knock retard 2} : 0"
      ]
    },
    {
      "name": "knock",
      "values": [0, 0, 0, 0, 0, 0],
      "expr": [
        "(({knock status 1} & 7) == 1) ? x0 = {knock amplitude 1} : 0",
        "(({knock status 1} & 7) == 2) ? x1 = {knock amplitude 1} : 0",
        "(({knock status 1} & 7) == 3) ? x2 = {knock amplitude 1} : 0",
        "(({knock status 2} & 7) == 4) ? x3 = {knock amplitude 2} : 0",
        "(({knock status 2} & 7) == 5) ? x4 = {knock amplitude 2} : 0",
        "(({knock status 2} & 7) == 6) ? x5 = {knock amplitude 2} : 0"
      ]
    }
